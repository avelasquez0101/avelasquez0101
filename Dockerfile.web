# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy all root configuration files
COPY package.json pnpm-workspace.yaml turbo.json ./

# Install ALL dependencies (including dev) for the entire monorepo
RUN npm install --legacy-peer-deps

# Copy all source code
COPY packages ./packages
COPY apps ./apps

# Build the web app using workspace command
WORKDIR /app/apps/web
RUN npm run build

# Production stage - use Node.js to serve Next.js standalone
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy package.json for web app
COPY apps/web/package.json ./

# Copy built app from builder
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./.next/static
COPY --from=builder /app/apps/web/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
