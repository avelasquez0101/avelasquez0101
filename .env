# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chgaming
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chgaming

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# JWT Configuration
JWT_SECRET=cambia_esto_por_un_secreto_muy_seguro_en_produccion_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PayPal Configuration (Sandbox)
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
PAYPAL_MODE=sandbox

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10

# VIP Configuration
VIP_MONTHLY_PRICE=9.99
VIP_XP_MULTIPLIER=1.5

# Tournament Configuration
MIN_TOURNAMENT_PARTICIPANTS=4
MAX_TOURNAMENT_PARTICIPANTS=64

# Email Configuration (Optional - for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Push Notifications (Optional - for mobile)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
